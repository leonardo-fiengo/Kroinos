NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONTACT_EMAIL=redazione@example.com

# Admin studio: https://your-domain.example/article
# Use a private value at least 12 characters long.
ADMIN_ACCESS_KEY=

# Recommended: a separate random value at least 32 characters long.
ADMIN_SESSION_SECRET=

# Durable publishing for Vercel/production. Use a fine-grained GitHub token
# with Contents: Read and write access only to this repository.
KROINOS_GITHUB_TOKEN=
KROINOS_GITHUB_REPOSITORY=owner/repository
KROINOS_GITHUB_BRANCH=main

# Endpoint HTTPS che riceve { email, source, consentAt }.
NEWSLETTER_WEBHOOK_URL=

# Facoltativo: inviato come Authorization: Bearer <token>.
NEWSLETTER_WEBHOOK_TOKEN=
